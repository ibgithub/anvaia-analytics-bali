# ==============================================================================
# Konfigurasi Database PostgreSQL (Host / VPS / Laptop / Cloud)
# ==============================================================================
# Default: pakai container postgres di docker-compose (tinggal docker compose up)
# Kalau mau pakai DB di host VPS (di luar container): ganti ke host.docker.internal
DB_HOST=postgres
DB_PORT=5432
DB_NAME=anvaia_bali
DB_USER=anvaia
DB_PASSWORD=anvaia
DB_EXTERNAL_PORT=5433

# ==============================================================================
# Konfigurasi Port Layanan di Host VPS
# ==============================================================================
APP_PORT=3000
AUTH_PORT=8091
EXECUTIVE_PORT=8092

# ==============================================================================
# Security, Domain & JWT
# ==============================================================================
JWT_SECRET=my-super-secret-key-minimum-32-bytes!!!
CORS_ALLOWED_ORIGINS=https://anvaia-bali.teman-umkm.com,http://anvaia-bali.teman-umkm.com,http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000
