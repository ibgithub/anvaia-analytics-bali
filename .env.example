# ==============================================================================
# Konfigurasi Database PostgreSQL (Host / VPS / Laptop / Cloud)
# ==============================================================================
# Jika DB berjalan di host VPS yang sama (di luar container): gunakan host.docker.internal
# Jika DB berjalan di laptop / server lain: masukkan IP / hostname, contoh: 192.168.1.50
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=anvaia-bali
DB_USER=anvaia
DB_PASSWORD=anvaia

# ==============================================================================
# Konfigurasi Port Layanan di Host VPS
# ==============================================================================
APP_PORT=3000
AUTH_PORT=8091
EXECUTIVE_PORT=8092

# ==============================================================================
# Security, Domain & JWT
# ==============================================================================
JWT_SECRET=my-super-secret-key-minimum-32-bytes!!!
CORS_ALLOWED_ORIGINS=https://cpi.teman-umkm.com,http://cpi.teman-umkm.com,http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000
